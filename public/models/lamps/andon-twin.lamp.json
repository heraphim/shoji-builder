{
  "id": "andon-twin",
  "description": "Six posts. A centre post stands in the middle of the front and of the back, and each of those faces carries two narrow panels instead of one wide one. The rails are the rails of a four-post lamp, unaltered: they run straight through the centre posts, which are mortised across the full section for them and threaded on rather than joined to their ends. It is the lamp to build when the width is more than a single sheet of paper wants to span.",
  "type": "lamp",
  "format": 2,
  "units": "mm",
  "variables": {
    "beamDepth": "10",
    "beamExtra": "20",
    "beamHeight": "15",
    "frameHeight": "#frameWidth",
